# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://bvtlkvsytlyxcowyavcj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser. Used for
# admin actions (inviting users). Keep this out of version control.
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Outbound mail for the daily store report.
#
# OPTIONAL: the mail server is normally set from Admin -> Mail server, which
# is stored in the database and changeable without a redeploy. These are a
# fallback, used only when nothing is saved there — handy for a fresh
# deployment, or to get back in if the saved settings are ever wrong.
#
# With neither, the report is skipped and logged rather than failing, so saving
# the day's numbers still works on a machine with no mail server.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The envelope sender. Falls back to SMTP_USER.
SMTP_FROM=Lapis Sales Tracker <reports@lapis.com>

# Absolute base for links and images in that email. Falls back to the
# production domain.
NEXT_PUBLIC_APP_URL=https://lapisreport.dealerhaven.app
